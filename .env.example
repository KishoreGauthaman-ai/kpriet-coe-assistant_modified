# KPRIET COE Assistant — Docker environment overrides
# Copy to .env and adjust values before running `docker compose up`.

# --- JWT secret (CHANGE THIS in production!) ---
JWT_SECRET=please-replace-this-with-a-long-random-secret

# --- Default admin credentials ---
SEED_ADMIN_EMAIL=admin@kpriet.ac.in
SEED_ADMIN_PASSWORD=KPR@1234
SEED_ADMIN_NAME=COE Administrator

# --- LLM parameters ---
MAX_TOKENS=512
DISTANCE_THRESHOLD=0.45
TEMPERATURE=0.3

# --- Embedder GPU layers (0 = CPU, >0 = GPU offload) ---
EMBED_N_GPU_LAYERS=0

# --- Voice device (cpu or cuda) ---
VOICE_DEVICE=cpu
VOICE_COMPUTE_TYPE=int8

# --- Ports ---
# Frontend (browser):    3000 → container :80
# Backend  (FastAPI):    8000 → container :8000
# Base LLM (llama.cpp):  8080 → container :8080
# Reasoning LLM:         8081 → container :8081
