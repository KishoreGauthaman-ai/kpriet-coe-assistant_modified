# KPRIET COE Assistant — backend environment variables
# Copy to `.env` and adjust as needed. DO NOT commit real secrets.

ENV=dev
HOST=127.0.0.1
PORT=8000
FRONTEND_URL=http://127.0.0.1:5173

# --- llama.cpp HTTP servers ---
BASE_SERVER_URL=http://127.0.0.1:8080
REASONING_SERVER_URL=http://127.0.0.1:8081

# --- Embedder (in-process) ---
EMBED_N_GPU_LAYERS=0
EMBED_N_THREADS=8
EMBED_BATCH_SIZE=32

# --- Voice (in-process) ---
VOICE_DEVICE=cpu
VOICE_COMPUTE_TYPE=int8

# --- RAG ---
DISTANCE_THRESHOLD=0.45
RETRIEVE_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# --- LLM ---
MAX_TOKENS=512
TEMPERATURE=0.3

# --- Auth (CHANGE JWT_SECRET in production!) ---
JWT_SECRET=please-replace-this-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Default seeded admin ---
SEED_ADMIN_EMAIL=admin@kpriet.ac.in
SEED_ADMIN_PASSWORD=KPR@1234
SEED_ADMIN_NAME=COE Administrator
